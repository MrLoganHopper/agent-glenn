# Server
PORT=8787
APP_NAME=Beacon

# Set true while testing the UI without placing real calls or texts.
DEMO_DRY_RUN=true
TRUSTED_CALL_DELAY_MS=1800

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Optional alternative to TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=

# ElevenLabs outbound calls through your connected Twilio number
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_RECORD_CALLS=false

# Keep these off for the simplest setup. Select the GPT model in the ElevenLabs UI.
ELEVENLABS_ENABLE_OVERRIDES=false
ELEVENLABS_LLM_OVERRIDE=

# Glendale GIS MCP, optional. The app has a built-in safe fallback.
GLENDALE_MCP_ENABLED=false
GLENDALE_MCP_URL=https://glendale-gis-mcp-1053589358088.us-west2.run.app/mcp
GLENDALE_MCP_API_KEY=
MCP_PROTOCOL_VERSION=2025-06-18
GLENDALE_MCP_TIMEOUT_MS=4500
